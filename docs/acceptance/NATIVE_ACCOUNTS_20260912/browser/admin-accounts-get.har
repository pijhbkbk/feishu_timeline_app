g{color:var(--r22-text);font-size:15px;line-height:1.2}.r22-brand small{color:var(--r22-muted);font-size:11px;line-height:1.2}.r22-primary-nav{display:flex;align-items:center;gap:4px;padding:5px;border:1px solid rgba(226,229,233,.82);border-radius:14px;background:rgba(245,245,247,.72)}.r22-primary-nav a{position:relative;display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:0 16px;border-radius:10px;color:var(--r22-muted);font-size:14px;font-weight:650;white-space:nowrap;transition:color .16s ease,background .16s ease,box-shadow .16s ease}.r22-primary-nav a:hover{color:var(--r22-text)}.r22-primary-nav a.is-active{color:var(--r22-brand);background:#fff;box-shadow:0 3px 10px rgba(29,29,31,.08)}.r22-header-tools{display:flex;align-items:center;justify-content:flex-end;gap:8px}.r22-icon-button{display:inline-flex;align-items:center;justify-content:center;width:38px;min-width:38px;height:38px;min-height:38px;padding:0;border:1px solid transparent;border-radius:50%;color:var(--r22-text);font-size:19px;font-weight:600;background:transparent;box-shadow:none;cursor:pointer}.r22-icon-button:hover{border-color:var(--r22-border);background:var(--r22-surface-muted)}.r22-profile-menu{position:relative}.r22-profile-menu summary{display:flex;list-style:none;cursor:pointer}.r22-profile-menu summary::-webkit-details-marker{display:none}.r22-avatar{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border:1px solid rgba(49,95,134,.18);border-radius:50%;color:var(--r22-brand);font-size:14px;font-weight:750;background:var(--r22-brand-soft)}.r22-avatar-loading{animation:r22-pulse 1.2s ease-in-out infinite}.r22-profile-popover{position:absolute;top:48px;right:0;display:grid;grid-gap:7px;gap:7px;min-width:230px;padding:18px;border:1px solid var(--r22-border);border-radius:18px;background:#fff;box-shadow:0 24px 70px rgba(29,29,31,.15)}.r22-profile-popover strong{font-size:17px}.r22-profile-popover small,.r22-profile-popover span{color:var(--r22-muted);font-size:13px}.r22-profile-popover a,.r22-profile-popover button{min-height:38px;margin-top:4px;padding:0 12px;border:0;border-radius:10px;color:var(--r22-brand);font-weight:650;text-align:left;background:var(--r22-brand-soft);cursor:pointer}.r22-login-link{color:var(--r22-brand);font-size:14px;font-weight:700}.r22-content{display:grid;grid-gap:24px;gap:24px;width:min(calc(100% - 64px),var(--r22-content));margin:0 auto;padding:24px 0 64px}.r22-context-nav{display:flex;flex-wrap:nowrap;gap:4px;width:100%;padding:5px;overflow-x:auto;border:1px solid rgba(226,229,233,.9);border-radius:14px;background:rgba(255,255,255,.82);box-shadow:none}.r22-context-nav .context-nav-link{min-height:36px;padding:0 14px;border:0;border-radius:10px;color:var(--r22-muted);font-size:14px;background:transparent;box-shadow:none;white-space:nowrap}.r22-context-nav .context-nav-link-active{color:var(--r22-brand);background:var(--r22-brand-soft)}.r22-page{display:grid;grid-gap:32px;gap:32px;width:100%;min-width:0}.r22-page-hero,.r22-project-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;padding:30px 4px 8px}.r22-page-hero>div:first-child,.r22-project-hero>div:first-child{display:grid;grid-gap:9px;gap:9px}.r22-page-hero h1,.r22-project-hero h1{margin:0;color:var(--r22-text);font-size:clamp(36px,3.2vw,40px);font-weight:720;letter-spacing:-.035em;line-height:1.08}.r22-page-hero p,.r22-project-hero p{margin:0;color:var(--r22-muted);font-size:16px;line-height:1.55}.r22-breadcrumb,.r22-overline{color:var(--r22-brand)!important;font-size:13px!important;font-weight:720;letter-spacing:.02em}.r22-breadcrumb{display:flex;gap:8px}.r22-page-hero-actions,.r22-project-hero-actions{display:flex;align-items:center;gap:10px}.r22-page-hero-actions>span,.r22-project-hero-actions>span{color:var(--r22-muted);font-size:13px}.r22-card{min-width:0;padding:28px;border:1px solid var(--r22-border);border-radius:var(--r22-radius);background:var(--r22-surface);box-shadow:var(--r22-shadow)}.r22-card h1,.r22-card h2,.r22-card h3,.r22-card p{margin-top:0}.r22-section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:20px}.r22-section-heading>div{display:grid;grid-gap:5px;gap:5px}.r22-section-heading h2{margin:0;color:var(--r22-text);font-size:26px;font-weight:700;letter-spacing:-.025em;line-height:1.15}.r22-section-heading p:not(.r22-overline){margin:3px 0 0;color:var(--r22-muted);font-size:14px}.r22-text-link{color:var(--r22-brand);font-size:14px;font-weight:680;white-space:nowrap}.r22-button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 20px;border:1px solid transparent;border-radius:12px;font-size:15px;font-weight:680;line-height:1;cursor:pointer;transition:transform .16s ease,box-shadow .16s ease,background .16s ease}.r22-button:hover:not(:disabled){transform:translateY(-1px)}.r22-button:disabled{cursor:not-allowed;opacity:.55}.r22-button-primary{color:#fff;background:var(--r22-brand);box-shadow:0 8px 18px rgba(49,95,134,.2)}.r22-button-primary:hover:not(:disabled){background:#284f70;box-shadow:0 11px 24px rgba(49,95,134,.26)}.r22-button-secondary{border-color:var(--r22-border);color:var(--r22-text);background:#fff}.r22-button-secondary:hover:not(:disabled){background:var(--r22-surface-muted)}.r22-button-danger{color:#fff;background:var(--r22-danger);box-shadow:0 8px 18px rgba(185,76,76,.2)}.r22-button-danger:hover:not(:disabled){background:#9f3f3f;box-shadow:0 11px 24px rgba(185,76,76,.25)}.r22-status{display:inline-flex;align-items:center;width:-moz-fit-content;width:fit-content;min-height:28px;padding:0 11px;border-radius:999px;font-size:13px;font-weight:700;white-space:nowrap}.r22-status-brand{color:var(--r22-brand);background:var(--r22-brand-soft)}.r22-status-success{color:var(--r22-success);background:var(--r22-success-soft)}.r22-status-warning{color:var(--r22-warning);background:var(--r22-warning-soft)}.r22-status-danger{color:var(--r22-danger);background:var(--r22-danger-soft)}.r22-status-monthly{color:var(--r22-monthly);background:var(--r22-monthly-soft)}.r22-status-neutral{color:var(--r22-muted);background:#f0f1f3}.r22-progress{width:100%;height:6px;overflow:hidden;border-radius:999px;background:#eceef1}.r22-progress>span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--r22-brand),#5f88aa);transition:width .24s ease}.r22-inline-alert{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:48px;padding:10px 16px;border:1px solid rgba(185,76,76,.2);border-radius:12px;color:var(--r22-danger);font-size:14px;background:var(--r22-danger-soft)}.r22-inline-alert button{border:0;color:inherit;font-weight:700;background:transparent;cursor:pointer}.r22-state-card{display:grid;justify-items:start;grid-gap:16px;gap:16px;max-width:720px;margin:80px auto;padding:42px}.r22-state-card h1,.r22-state-card h2{margin:0;font-size:30px}.r22-muted,.r22-state-card p{margin:0;color:var(--r22-muted);line-height:1.7}.r22-dashboard-focus{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.65fr);grid-gap:24px;gap:24px;align-items:stretch}.r22-dashboard-focus>div,.r22-next-panel{display:grid;align-content:start}.r22-task-card{display:grid;grid-gap:24px;gap:24px;height:100%;padding:28px;border:1px solid var(--r22-border);border-radius:var(--r22-radius);background:#fff;box-shadow:var(--r22-shadow)}.r22-task-card-primary{min-height:360px;padding:34px;background:radial-gradient(circle at 100% 0,rgba(49,95,134,.1),transparent 35%),#fff}.r22-task-card-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:24px}.r22-task-card-heading>div{display:grid;grid-gap:8px;gap:8px}.r22-task-card-heading span{color:var(--r22-brand);font-size:13px;font-weight:700}.r22-task-card-heading h2{max-width:720px;margin:0;color:var(--r22-text);font-size:28px;letter-spacing:-.025em;line-height:1.2}.r22-task-card-heading p{margin:0;color:var(--r22-muted);font-size:16px}.r22-task-meta{display:grid;grid-template-columns:1.4fr 1fr 1fr;grid-gap:12px;gap:12px}.r22-task-meta>span{display:grid;grid-gap:5px;gap:5px;padding:15px 16px;border-radius:14px;background:var(--r22-surface-muted)}.r22-task-meta small{color:var(--r22-muted);font-size:12px}.r22-task-meta strong{color:var(--r22-text);font-size:15px}.is-danger,.r22-task-meta strong.is-danger{color:var(--r22-danger)!important}.r22-task-actions{display:flex;gap:10px;align-items:flex-end;margin-top:auto}.r22-next-panel{padding-top:0}.r22-next-task{display:grid;align-content:start;grid-gap:15px;gap:15px;height:100%;min-height:360px;padding:28px;border:1px solid var(--r22-border);border-radius:var(--r22-radius);background:#fff;box-shadow:var(--r22-shadow)}.r22-next-task h3{margin:3px 0 0;color:var(--r22-text);font-size:20px;line-height:1.3}.r22-next-task>p{margin:-7px 0 4px;color:var(--r22-muted);font-size:14px}.r22-next-task dl{display:grid;grid-gap:10px;gap:10px;margin:0}.r22-next-task dl div{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--r22-border)}.r22-next-task dt{color:var(--r22-muted);font-size:13px}.r22-next-task dd{margin:0;font-size:14px;font-weight:680}.r22-next-task .r22-button{margin-top:auto}.r22-next-task-empty{justify-items:center;align-content:center;text-align:center}.r22-empty-icon,.r22-next-task-empty>span{display:inline-flex;align-items:center;justify-content:center;width:54px;height:54px;border-radius:50%;color:var(--r22-success);font-size:25px;background:var(--r22-success-soft)}.r22-empty-focus{display:grid;justify-items:center;align-content:center;grid-gap:14px;gap:14px;min-height:360px;text-align:center}.r22-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-gap:18px;gap:18px}.r22-kpi{position:relative;display:grid;grid-gap:9px;gap:9px;min-height:146px;padding:24px;overflow:hidden;border:1px solid var(--r22-border);border-radius:var(--r22-radius);background:#fff;box-shadow:var(--r22-shadow)}.r22-kpi:after{content:\"\";position:absolute;top:0;left:24px;width:36px;height:3px;border-radius:0 0 4px 4px;background:#a5abb4}.r22-kpi-brand:after{background:var(--r22-brand)}.r22-kpi-success:after{background:var(--r22-success)}.r22-kpi-warning:after{background:var(--r22-warning)}.r22-kpi-danger:after{background:var(--r22-danger)}.r22-kpi-monthly:after{background:var(--r22-monthly)}.r22-kpi>span{color:var(--r22-muted);font-size:14px;font-weight:650}.r22-kpi>strong{color:var(--r22-text);font-size:34px;letter-spacing:-.035em;line-height:1}.r22-kpi>small{align-self:end;color:var(--r22-muted);font-size:13px}.r22-activity-card{padding-bottom:18px}.r22-activity-list{display:grid}.r22-activity-list article{display:grid;grid-template-columns:12px minmax(0,1fr) auto;grid-gap:14px;gap:14px;align-items:center;min-height:68px;border-top:1px solid var(--r22-border)}.r22-activity-list article:first-child{border-top:0}.r22-activity-dot{width:8px;height:8px;border-radius:50%;background:var(--r22-brand)}.r22-activity-list article div{display:grid;grid-gap:3px;gap:3px}.r22-activity-list strong{color:var(--r22-text);font-size:15px}.r22-activity-list p{margin:0}.r22-activity-list p,.r22-activity-list time{color:var(--r22-muted);font-size:13px}.r22-project-title-row{display:flex;align-items:center;gap:14px}.r22-project-summary-bar{display:grid;grid-template-columns:auto minmax(180px,1fr) minmax(520px,auto);grid-gap:20px;gap:20px;align-items:center;min-height:76px;padding:17px 22px;border:1px solid var(--r22-border);border-radius:16px;background:rgba(255,255,255,.82)}.r22-project-summary-bar>div:first-child{display:flex;align-items:baseline;gap:8px;white-space:nowrap}.r22-project-summary-bar dt,.r22-project-summary-bar span{color:var(--r22-muted);font-size:12px}.r22-project-summary-bar strong{font-size:18px}.r22-project-summary-bar dl{display:grid;grid-template-columns:repeat(3,auto);grid-gap:22px;gap:22px;margin:0}.r22-project-summary-bar dl div{display:grid;grid-gap:3px;gap:3px}.r22-project-summary-bar dd{margin:0;color:var(--r22-text);font-size:13px;font-weight:680}.r22-project-workspace-grid{display:grid;grid-template-columns:minmax(0,2.1fr) minmax(330px,.9fr);grid-gap:24px;gap:24px;align-items:start}.r22-current-stage-card,.r22-process-card{min-height:720px}.r22-process-legend{display:flex;gap:14px;color:var(--r22-muted);font-size:12px}.r22-process-legend span{display:inline-flex;align-items:center;gap:6px}.r22-process-legend i{width:8px;height:8px;border-radius:50%;background:#c7cbd1}.r22-process-legend .is-done{background:var(--r22-success)}.r22-process-legend .is-current{background:var(--r22-brand)}.r22-process-legend .is-risk{background:var(--r22-danger)}.r22-process-map{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-gap:18px 34px;gap:18px 34px;padding:6px 2px 2px}.r22-process-node{position:relative;display:grid;grid-template-columns:32px minmax(0,1fr);grid-gap:3px 11px;gap:3px 11px;min-height:76px;padding:14px;border:1px solid var(--r22-border);border-radius:14px;color:var(--r22-text);text-align:left;background:#fff;cursor:pointer;transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease,opacity .16s ease}.r22-process-node:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(29,29,31,.08)}.r22-process-node>span{grid-row:1/span 2;display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:10px;color:var(--r22-muted);font-size:12px;font-weight:750;background:#f0f1f3}.r22-process-node strong{font-size:14px;line-height:1.25}.r22-process-node small,.r22-process-node strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.r22-process-node small{color:var(--r22-muted);font-size:11px}.r22-process-node>i{position:absolute;top:50%;right:-35px;width:34px;height:1px;background:var(--r22-border)}.r22-process-node:nth-child(3n)>i{top:auto;right:50%;bottom:-19px;width:1px;height:18px}.r22-process-node-done{border-color:rgba(54,122,84,.24);backgro