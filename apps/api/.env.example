NODE_ENV=development
DEPLOYMENT_ENV=local
RUNTIME_COMMIT=unknown
BUILD_TIME=unknown
RELEASE=development
PORT=3001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feishu_timeline?schema=public
REDIS_URL=redis://localhost:6379
NOTIFICATION_QUEUE_ENABLED=true
NOTIFICATION_QUEUE_POLL_MS=5000
NOTIFICATION_OVERDUE_SCAN_MS=300000
NOTIFICATION_RETRY_DELAY_MS=5000
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_REDIS_QUEUE_MAX_JOBS=2000
NOTIFICATION_MEMORY_QUEUE_MAX_JOBS=1000
NOTIFICATION_MEMORY_DEDUPE_MAX_KEYS=5000
NOTIFICATION_JOB_MAX_BYTES=65536
NOTIFICATION_SCAN_BATCH_SIZE=100
NOTIFICATION_SCAN_MAX_ITEMS=1000
AUTH_MOCK_ENABLED=false
SESSION_COOKIE_NAME=ft_session
SESSION_TTL_SECONDS=28800
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=var/object-storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=feishu-timeline-local
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
UPLOAD_ADMISSION_GLOBAL_LIMIT=4
UPLOAD_ADMISSION_PER_ACTOR_LIMIT=2
UPLOAD_ADMISSION_PER_TARGET_LIMIT=3
UPLOAD_ADMISSION_RATE_MAX_REQUESTS=6
UPLOAD_ADMISSION_RATE_WINDOW_MS=60000
DOWNLOAD_ADMISSION_GLOBAL_LIMIT=8
DOWNLOAD_ADMISSION_PER_ACTOR_LIMIT=2
DOWNLOAD_ADMISSION_PER_TARGET_LIMIT=2
DOWNLOAD_ADMISSION_RATE_MAX_REQUESTS=12
DOWNLOAD_ADMISSION_RATE_WINDOW_MS=60000
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_REDIRECT_URI=http://localhost:3000/login/callback
OAUTH_PROVIDER=feishu-cn
FEISHU_AUTHORIZATION_ENDPOINT=https://accounts.feishu.cn/open-apis/authen/v1/index
