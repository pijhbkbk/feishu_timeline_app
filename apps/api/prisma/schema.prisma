generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectRetrospectiveStatus {
  DRAFT
  COMPLETED
}

enum ProjectMemberType {
  OWNER
  MANAGER
  MEMBER
  REVIEWER
  OBSERVER
}

enum ProjectAssignmentSource {
  TASK_OVERRIDE
  PROJECT_NODE_OVERRIDE
  PROJECT_DEPARTMENT_LEAD
  PROJECT_DEFAULT_ASSIGNEE
  SINGLE_ELIGIBLE_MEMBER
  UNASSIGNED
}

enum ColorStatus {
  DRAFT
  ACTIVE
  APPROVED
  REJECTED
  ARCHIVED
  EXITED
}

enum ColorVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum ColorRegisterStatus {
  CANDIDATE
  LISTED
  PENDING_REVIEW
}

model ProductionBase {
  inspectionActivities InspectionActivity[]
  id        String  @id @default(cuid())
  code      String  @unique @db.VarChar(64)
  name      String  @db.VarChar(200)
  colors    Color[]
  productionFacts ColorProductionFact[]
  @@map("production_bases")
}

model HueStandard {
  id        String  @id @default(cuid())
  name      String  @db.VarChar(200)
  basis     String  @db.VarChar(1000)
  colors    Color[]
  @@map("hue_standards")
}

model ColorImportBatch {
  id             String @id @default(cuid())
  sha256         String @unique @db.VarChar(64)
  fileName       String @db.VarChar(255)
  byteSize       Int
  objectKey      String @db.VarChar(512)
  parserVersion  String @db.VarChar(100)
  importedById   String
  importedBy     User @relation(fields: [importedById], references: [id], onDelete: Restrict)
  sheetCount     Int
  rowCount       Int
  colorCount     Int
  metadata       Json
  createdAt      DateTime @default(now())
  rows           ColorImportRow[]
  @@map("color_import_batches")
}

model ColorImportRow {
  id             String @id @default(cuid())
  batchId        String
  sheetName      String @db.VarChar(200)
  rowNumber      Int
  kind           String @db.VarChar(100)
  status         String @db.VarChar(40)
  rawCells       Json
  normalization  Json?
  colorId        String?
  batch          ColorImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  color          Color? @relation(fields: [colorId], references: [id], onDelete: Restrict)
  productionFacts ColorProductionFact[]
  @@unique([batchId, sheetName, rowNumber])
  @@index([colorId])
  @@index([batchId, status, sheetName, rowNumber])
  @@map("color_import_rows")
}

model ColorProductionFact {
  originalSource Json?
  id               String @id @default(cuid())
  colorId          String
  productionBaseId String
  month            String @db.VarChar(7)
  metricScope      String @db.VarChar(200)
  quantity         Decimal? @db.Decimal(18, 3)
  sourceRowId      String?
  sourceCell       String? @db.VarChar(32)
  revision         Int @default(1)
  color            Color @relation(fields: [colorId], references: [id], onDelete: Restrict)
  productionBase   ProductionBase @relation(fields: [productionBaseId], references: [id], onDelete: Restrict)
  sourceRow        ColorImportRow? @relation(fields: [sourceRowId], references: [id], onDelete: Restrict)
  @@unique([colorId, productionBaseId, month, metricScope])
  @@index([productionBaseId, month, metricScope])
  @@map("color_production_facts")
}

enum WorkflowNodeCode {
  PROJECT_INITIATION
  DEVELOPMENT_REPORT
  PAINT_DEVELOPMENT
  SAMPLE_COLOR_CONFIRMATION
  COLOR_NUMBERING
  PAINT_PROCUREMENT
  PERFORMANCE_TEST
  STANDARD_BOARD_PRODUCTION
  BOARD_DETAIL_UPDATE
  FIRST_UNIT_PRODUCTION_PLAN
  TRIAL_PRODUCTION
  CAB_REVIEW
  DEVELOPMENT_ACCEPTANCE
  COLOR_CONSISTENCY_REVIEW
  MASS_PRODUCTION_PLAN
  MASS_PRODUCTION
  VISUAL_COLOR_DIFFERENCE_REVIEW
  PROJECT_CLOSED
}

enum WorkflowInstanceStatus {
  DRAFT
  RUNNING
  COMPLETED
  CANCELLED
}

enum WorkflowTaskStatus {
  PENDING
  READY
  IN_PROGRESS
  APPROVED
  REJECTED
  RETURNED
  COMPLETED
  CANCELLED
}

enum TaskBlockerStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum WorkflowAction {
  SUBMIT
  ASSIGN
  START
  COMPLETE
  APPROVE
  REJECT
  RETURN
  REOPEN
  CANCEL
  SYSTEM_SYNC
}

enum WorkflowDurationType {
  WORKDAY
  SAME_DAY
  MONTH_END
  MONTH_OFFSET
  MANUAL_REVIEW_PASS
  RECURRING_MONTHLY
}

enum ProcessTemplateStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum WorkCalendarDayType {
  WORKDAY
  WEEKEND
  HOLIDAY
  ADJUSTED_WORKDAY
}

enum RecurringPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RecurringTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum SystemParameterValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum ColorExitSuggestion {
  EXIT
  RETAIN
  OBSERVE
}

enum SampleType {
  PANEL
  CAB
  VEHICLE
  OTHER
}

enum SampleStatus {
  DRAFT
  IN_PREPARATION
  CONFIRMED
  ARCHIVED
}

enum StandardBoardStatus {
  DRAFT
  CREATED
  ISSUED
  ARCHIVED
}

enum DistributionStatus {
  PENDING
  SENT
  RECEIVED
  LOST
  CANCELLED
}

enum ColorBoardDetailUpdateStatus {
  PENDING
  UPDATED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum ProcurementStatus {
  DRAFT
  ORDERED
  ARRIVED
  CANCELLED
}

enum PerformanceTestType {
  ADHESION
  IMPACT
  SALT_SPRAY
  HUMIDITY
  GLOSS
  HARDNESS
  DELTA_E
  THICKNESS
}

enum PerformanceTestStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum PerformanceTestResult {
  PASS
  FAIL
  OBSERVE
}

enum TrialProductionStatus {
  PLANNED
  IN_PROGRESS
  PASSED
  FAILED
  CANCELLED
}

enum TrialProductionResult {
  PASS
  FAIL
  PASS_WITH_ISSUES
}

enum TrialProductionIssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewType {
  CAB_REVIEW
  COLOR_CONSISTENCY_REVIEW
  VISUAL_COLOR_DIFFERENCE_REVIEW
  DEVELOPMENT_ACCEPTANCE
  OTHER
}

enum ReviewResult {
  PENDING
  APPROVED
  CONDITIONAL_APPROVED
  REJECTED
  NEED_REWORK
}

enum DevelopmentFeeType {
  PAINT_DEVELOPMENT
  SAMPLE_MAKING
  TESTING
  STANDARD_BOARD
  PROCUREMENT
  OTHER
}

enum DevelopmentFeeStatus {
  PENDING
  RECORDED
  PAID
  CANCELLED
}

enum ProductionPlanType {
  FIRST_UNIT
  SCHEDULE
  MASS_PRODUCTION
}

enum ProductionPlanStatus {
  DRAFT
  CONFIRMED
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttachmentTargetType {
  SHEET_COLOR
  SHEET_PERSON
  SHEET_INSPECTION
  SHEET_PRODUCTION
  PROJECT
  COLOR
  COLOR_VERSION
  WORKFLOW_TASK
  SAMPLE
  STANDARD_BOARD
  PERFORMANCE_TEST
  TRIAL_PRODUCTION
  REVIEW_RECORD
  NEW_COLOR_REPORT
  PRODUCTION_PLAN
  OTHER
}

enum AttachmentScanStatus {
  PENDING_SCAN
  CLEAN
  REJECTED
  SCAN_ERROR
  LEGACY_UNSCANNED
}

enum AttachmentBinaryState {
  RESERVED
  RETAINED
  PURGING
  PURGED
  RECONCILIATION_REQUIRED
}

enum NotificationType {
  TASK_ASSIGNED
  REVIEW_PENDING
  TASK_RETURNED
  TASK_OVERDUE
  SYSTEM_INFO
}

enum NotificationSendChannel {
  IN_APP
  FEISHU
}

enum NotificationSendStatus {
  PENDING
  SENT
  FAILED
}

enum DevelopmentReportStatus {
  DRAFT
  SUBMITTED
}

enum SampleConfirmationDecision {
  APPROVE
  REJECT
  RETURN
}

enum AuditTargetType {
  PERSON_PROFILE
  PROJECT
  COLOR
  COLOR_EXIT
  COLOR_VERSION
  DEVELOPMENT_REPORT
  WORKFLOW_INSTANCE
  WORKFLOW_TASK
  NOTIFICATION
  SAMPLE
  STANDARD_BOARD
  PAINT_PROCUREMENT
  PERFORMANCE_TEST
  TRIAL_PRODUCTION
  REVIEW_RECORD
  DEVELOPMENT_FEE
  PRODUCTION_PLAN
  ATTACHMENT
  USER
  ROLE
  SUPPLIER
  SYSTEM
}

model Department {
  personProfiles PersonProfile[]
  id                     String                    @id @default(cuid())
  code                   String                    @unique
  name                   String
  parentId               String?
  path                   String?
  level                  Int                       @default(1)
  sortOrder              Int                       @default(0)
  isActive               Boolean                   @default(true)
  leadUserId             String?
  parent                 Department?               @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children               Department[]              @relation("DepartmentHierarchy")
  leadUser               User?                     @relation("DepartmentLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  users                  User[]
  ownedProjects          Project[]                 @relation("OwningDepartmentProjects")
  assignedWorkflowTasks  WorkflowTask[]            @relation("TaskAssigneeDepartment")
  projectNodeAssignments ProjectNodeAssignment[]
  boardDistributionUsers BoardDistributionRecord[] @relation("BoardRecipientDepartment")
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([parentId])
  @@index([leadUserId])
  @@index([isActive, sortOrder])
  @@map("departments")
}

model User {
  uploadedSheetImages SheetImage[] @relation("SheetImageUploader")
  inspectionActivitiesCreated InspectionActivity[] @relation("InspectionActivityCreator")
  personProfile PersonProfile?
  colorImports                  ColorImportBatch[]
  id                            String                    @id @default(cuid())
  username                      String                    @unique
  name                          String
  email                         String?                   @unique
  mobile                        String?                   @unique
  feishuUserId                  String?                   @unique
  feishuOpenId                  String?                   @unique
  feishuUnionId                 String?                   @unique
  departmentId                  String?
  status                        UserStatus                @default(ACTIVE)
  isSystemAdmin                 Boolean                   @default(false)
  teamAccessApproved            Boolean                   @default(false)
  department                    Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ledDepartments                Department[]              @relation("DepartmentLead")
  authVersion                   Int                       @default(0)
  requestedJob                  String?                   @db.VarChar(32)
  onboardingCompleted           Boolean                   @default(true)
  localCredential               LocalCredential?
  authInitialization            AuthInitialization?
  userRoles                     UserRole[]
  ownedProjects                 Project[]                 @relation("ProjectOwner")
  projectMembers                ProjectMember[]
  createdColorVersions          ColorVersion[]            @relation("ColorVersionCreator")
  initiatedWorkflowInstances    WorkflowInstance[]        @relation("WorkflowInitiator")
  assignedWorkflowTasks         WorkflowTask[]            @relation("TaskAssigneeUser")
  ownedProjectNodeAssignments   ProjectNodeAssignment[]   @relation("ProjectNodeAssignmentOwner")
  updatedProjectNodeAssignments ProjectNodeAssignment[]   @relation("ProjectNodeAssignmentUpdater")
  r26CommandRequests            R26CommandRequest[]       @relation("R26CommandActor")
  workflowTransitions           WorkflowTransition[]      @relation("WorkflowTransitionOperator")
  boardDistributions            BoardDistributionRecord[] @relation("BoardRecipientUser")
  requestedPaintProcurements    PaintProcurement[]        @relation("ProcurementRequester")
  reviewRecords                 ReviewRecord[]            @relation("ReviewReviewer")
  createdDevelopmentReports     DevelopmentReport[]       @relation("DevelopmentReportCreator")
  updatedDevelopmentReports     DevelopmentReport[]       @relation("DevelopmentReportUpdater")
  submittedDevelopmentReports   DevelopmentReport[]       @relation("DevelopmentReportSubmitter")
  sampleConfirmations           SampleConfirmation[]      @relation("SampleConfirmationActor")
  performedPerformanceTests     PerformanceTest[]         @relation("PerformanceTestOperator")
  issuedStandardBoards          StandardBoard[]           @relation("StandardBoardIssuer")
  updatedColorBoardDetails      ColorBoardDetailUpdate[]  @relation("ColorBoardDetailUpdateOperator")
  createdDevelopmentFees        DevelopmentFee[]          @relation("DevelopmentFeeCreator")
  recordedDevelopmentFees       DevelopmentFee[]          @relation("DevelopmentFeeRecorder")
  createdProductionPlans        ProductionPlan[]          @relation("ProductionPlanCreator")
  ownedProductionPlans          ProductionPlan[]          @relation("ProductionPlanOwner")
  confirmedProductionPlans      ProductionPlan[]          @relation("ProductionPlanConfirmer")
  operatedColorExits            ColorExit[]               @relation("ColorExitOperator")
  uploadedAttachments           Attachment[]              @relation("AttachmentUploader")
  deletedAttachments            Attachment[]              @relation("AttachmentDeleter")
  submittedTaskProgressUpdates  TaskProgressUpdate[]      @relation("TaskProgressSubmitter")
  r26ProgressDrafts             R26ProgressDraft[]        @relation("R26ProgressDraftAuthor")
  assistedTaskBlockers          TaskBlocker[]             @relation("TaskBlockerHelper")
  completedRetrospectives       ProjectRetrospective[]    @relation("RetrospectiveCompleter")
  notifications                 Notification[]
  auditLogs                     AuditLog[]                @relation("AuditActor")
  adminSavedViews               AdminSavedView[]
  adminCommandRequests          AdminCommandRequest[]     @relation("AdminCommandActor")
  projectCreateCommandRequests ProjectCreateCommandRequest[]
  supplierMutationBucket        SupplierMutationBucket?
  supplierCommandRequests       SupplierCommandRequest[]
  numberedColors                Color[]                   @relation("ColorNumberingOperator")
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt

  @@index([departmentId, status])
  @@map("users")
}

model LocalCredential {
  userId           String    @id
  loginName        String    @unique @db.VarChar(64)
  passwordHash     String?
  resetTokenHash   String?   @unique @db.VarChar(64)
  resetExpiresAt   DateTime?
  resetVersion     Int?
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("local_credentials")
}

model AuthInitialization {
  id          String   @id
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@map("auth_initialization")
}

model Role {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  status          RoleStatus       @default(ACTIVE)
  isSystem        Boolean          @default(true)
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  workflowTasks   WorkflowTask[] @relation("WorkflowRequiredRole")
  recurringTasks  RecurringTask[] @relation("RecurringRequiredRole")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@map("roles")
}

model RolePermission {
  id             String   @id @default(cuid())
  roleId         String
  permissionCode String
  description    String?
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([roleId, permissionCode])
  @@index([permissionCode])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Project {
  inspectionActivities InspectionActivity[]
  id                       String                    @id @default(cuid())
  primaryColorId           String?
  primaryColor             Color?                    @relation("ProjectPrimaryColor", fields: [primaryColorId], references: [id], onDelete: Restrict)
  code                     String                    @unique
  name                     String
  requiresApprovedReport   Boolean                   @default(false)
  approvedReportDate       DateTime?
  approvalReference        String?                   @db.VarChar(200)
  approvedReportAttachmentId String?                 @unique
  approvedReportAttachment Attachment?               @relation("ProjectApprovedReport", fields: [approvedReportAttachmentId], references: [id], onDelete: Restrict)
  description              String?
  status                   ProjectStatus             @default(DRAFT)
  priority                 ProjectPriority           @default(MEDIUM)
  currentNodeCode          WorkflowNodeCode?
  owningDepartmentId       String?
  ownerUserId              String?
  marketRegion             String?
  colorMarketingUnit       String?
  paintSupplier            String?
  vehicleModel             String?
  plannedStartDate         DateTime?
  plannedEndDate           DateTime?
  actualStartDate          DateTime?
  actualEndDate            DateTime?
  closedAt                 DateTime?
  owningDepartment         Department?               @relation("OwningDepartmentProjects", fields: [owningDepartmentId], references: [id], onDelete: SetNull)
  ownerUser                User?                     @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  members                  ProjectMember[]
  nodeAssignments          ProjectNodeAssignment[]
  r26CommandRequests       R26CommandRequest[]
  colors                   Color[]
  colorExits               ColorExit[]
  developmentReports       DevelopmentReport[]
  workflowInstances        WorkflowInstance[]
  workflowTasks            WorkflowTask[]
  workflowTransitions      WorkflowTransition[]
  taskProgressUpdates      TaskProgressUpdate[]
  r26ProgressDrafts        R26ProgressDraft[]
  taskBlockers             TaskBlocker[]
  samples                  Sample[]
  sampleConfirmations      SampleConfirmation[]
  standardBoards           StandardBoard[]
  boardDistributionRecords BoardDistributionRecord[]
  colorBoardDetailUpdates  ColorBoardDetailUpdate[]
  paintProcurements        PaintProcurement[]
  performanceTests         PerformanceTest[]
  trialProductions         TrialProduction[]
  reviewRecords            ReviewRecord[]
  developmentFees          DevelopmentFee[]
  productionPlans          ProductionPlan[]
  attachments              Attachment[]
  reminderItems            NotificationDigestItem[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  adminCommandRequests     AdminCommandRequest[]
  createCommandRequests    ProjectCreateCommandRequest[]
  retrospective            ProjectRetrospective?
  memberAssignmentVersion  Int                       @default(1)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([status, currentNodeCode])
  @@index([owningDepartmentId, status])
  @@index([ownerUserId, status])
  @@index([primaryColorId])
  @@map("projects")
}

model ProjectMember {
  id         String            @id @default(cuid())
  projectId  String
  userId     String
  memberType ProjectMemberType
  title      String?
  isPrimary  Boolean           @default(false)
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([projectId, userId, memberType])
  @@index([userId, memberType])
  @@map("project_members")
}

model ProjectNodeAssignment {
  id                  String                  @id @default(cuid())
  projectId           String
  nodeCode            WorkflowNodeCode
  primaryDepartmentId String?
  ownerUserId         String?
  collaboratorUserIds Json?
  reviewerUserIds     Json?
  assignmentSource    ProjectAssignmentSource @default(PROJECT_NODE_OVERRIDE)
  version             Int                     @default(1)
  updatedById         String?
  project             Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  primaryDepartment   Department?             @relation(fields: [primaryDepartmentId], references: [id], onDelete: SetNull)
  ownerUser           User?                   @relation("ProjectNodeAssignmentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  updatedBy           User?                   @relation("ProjectNodeAssignmentUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([projectId, nodeCode])
  @@index([ownerUserId, nodeCode])
  @@index([primaryDepartmentId, nodeCode])
  @@map("project_node_assignments")
}

model R26CommandRequest {
  id             String   @id @default(cuid())
  projectId      String
  actorUserId    String?
  idempotencyKey String   @unique
  action         String
  requestHash    String
  result         Json?
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorUser      User?    @relation("R26CommandActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([projectId, action, createdAt])
  @@index([actorUserId, createdAt])
  @@map("r26_command_requests")
}

model AdminSavedView {
  id        String   @id @default(cuid())
  userId    String
  pageKey   String
  name      String
  config    Json
  configBytes Int?
  version   Int      @default(1)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, pageKey, name])
  @@index([userId, pageKey, updatedAt])
  @@map("admin_saved_views")
}

model AdminCommandRequest {
  id             String   @id @default(cuid())
  projectId      String?
  actorUserId    String?
  idempotencyKey String   @unique
  action         String
  requestHash    String
  result         Json?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actorUser      User?    @relation("AdminCommandActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([projectId, action, createdAt])
  @@index([actorUserId, createdAt])
  @@map("admin_command_requests")
}

model ProjectCreateCommandRequest {
  id             String   @id @default(cuid())
  actorUserId    String
  idempotencyKey String   @db.VarChar(128)
  requestHash    String   @db.VarChar(64)
  projectId      String
  resultSnapshot Json
  actor          User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([actorUserId, idempotencyKey])
  @@index([actorUserId, createdAt])
  @@index([projectId])
  @@map("project_create_command_requests")
}

model Color {
  inspectionOccurrences InspectionOccurrence[]
  id                    String             @id @default(cuid())
  projectId             String?
  linkedProjects        Project[]          @relation("ProjectPrimaryColor")
  productionBaseId      String?
  productionBase        ProductionBase?    @relation(fields: [productionBaseId], references: [id], onDelete: Restrict)
  hueStandardId         String?
  hueStandard           HueStandard?       @relation(fields: [hueStandardId], references: [id], onDelete: Restrict)
  registerStatus        ColorRegisterStatus @default(PENDING_REVIEW)
  registerMonth         String?            @db.VarChar(7)
  registeredAt          DateTime?
  manufacturer          String?            @db.VarChar(200)
  paintType             String?            @db.VarChar(200)
  registerNote          String?            @db.VarChar(4000)
  registerRevision      Int                @default(1)
  sourceRows            ColorImportRow[]
  productionFacts       ColorProductionFact[]
  code                  String?            @unique
  name                  String
  description           String?
  status                ColorStatus        @default(DRAFT)
  isPrimary             Boolean            @default(false)
  exitFlag              Boolean            @default(false)
  exitDate              DateTime?
  numberingTaskId       String?            @unique
  numberedById          String?
  numberedAt            DateTime?
  numberingAttachmentId String?            @unique
  project               Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  numberingTask         WorkflowTask?      @relation("ColorNumberingTask", fields: [numberingTaskId], references: [id], onDelete: SetNull)
  numberedBy            User?              @relation("ColorNumberingOperator", fields: [numberedById], references: [id], onDelete: SetNull)
  numberingAttachment   Attachment?        @relation("ColorNumberingAttachment", fields: [numberingAttachmentId], references: [id], onDelete: SetNull)
  versions              ColorVersion[]
  colorExits            ColorExit[]        @relation("ColorExitColor")
  replacementInExits    ColorExit[]        @relation("ColorExitReplacementColor")
  samples               Sample[]
  standardBoards        StandardBoard[]
  paintProcurements     PaintProcurement[]
  trialProductions      TrialProduction[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([projectId, name])
  @@index([productionBaseId, registerStatus, id])
  @@index([hueStandardId])
  @@index([projectId, status])
  @@index([exitFlag, exitDate])
  @@index([numberedById, numberedAt])
  @@map("colors")
}

model ColorVersion {
  inspectionMeasurements InspectionMeasurement[]
  id                String             @id @default(cuid())
  colorId           String
  versionNo         Int
  versionName       String?
  status            ColorVersionStatus @default(DRAFT)
  formulaCode       String?
