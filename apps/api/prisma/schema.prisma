model Notification {
  id               String                  @id @default(cuid())
  userId           String
  projectId        String?
  taskId           String?
  notificationType NotificationType
  title            String
  content          String
  linkPath         String?
  dedupeKey        String?
  reminderKind     TaskReminderKind?
  businessDate     String? @db.VarChar(10)
  assignmentEpoch  Int?
  stageTaskId      String?
  recurringTaskId  String?
  stageTask        WorkflowTask? @relation("ReminderStage", fields: [stageTaskId], references: [id], onDelete: Restrict)
  recurringTask    RecurringTask? @relation(fields: [recurringTaskId], references: [id], onDelete: Restrict)
  digestItems      NotificationDigestItem[]
