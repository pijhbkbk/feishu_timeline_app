enum InspectionObjectKind {
  VEHICLE
  SAMPLE
}
enum InspectionConclusion {
  PENDING
  PASS
  FAIL
}
model InspectionActivity {
  id               String @id @default(cuid())
  activityDate     DateTime @db.Date
  productionBaseId String
  batchLabel       String? @db.VarChar(200)
  note             String? @db.VarChar(4000)
  revision         Int @default(1)
  createdById      String
  projectId        String?
  recurringTaskId  String?
  reviewRecordId   String? @unique
  productionBase   ProductionBase @relation(fields: [productionBaseId], references: [id], onDelete: Restrict)
  createdBy        User @relation("InspectionActivityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  project          Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recurringTask    RecurringTask? @relation(fields: [recurringTaskId], references: [id], onDelete: Restrict)
  reviewRecord     ReviewRecord? @relation(fields: [reviewRecordId], references: [id], onDelete: Restrict)
  participants     InspectionParticipant[]
  occurrences      InspectionOccurrence[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([productionBaseId, activityDate, id])
  @@index([projectId, recurringTaskId])
  @@map("inspection_activities")
}
model InspectionParticipant {
  activityId String
  personId String
  activity InspectionActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  person PersonProfile @relation(fields: [personId], references: [id], onDelete: Restrict)
  @@id([activityId, personId])
  @@index([personId])
  @@map("inspection_participants")
}
model InspectionObject {
  id String @id @default(cuid())
  objectKind InspectionObjectKind
  objectCode String @unique @db.VarChar(128)
  vin String? @unique @db.VarChar(32)
  vehicleModel String? @db.VarChar(200)
  vehicleClass String? @db.VarChar(100)
