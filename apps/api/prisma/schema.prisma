  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notificationId, taskKey])
  @@index([notificationId, id])
  @@index([projectId])
  @@index([workflowTaskId])
  @@index([recurringTaskId])
  @@index([stageTaskId])
  @@map("notification_digest_items")
}

