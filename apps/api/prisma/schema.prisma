  updatedAt        DateTime                @updatedAt

  @@index([stageTaskId])
  @@index([recurringTaskId])
  @@unique([sendChannel, dedupeKey])
  @@index([userId, isRead, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([notificationType, createdAt])
