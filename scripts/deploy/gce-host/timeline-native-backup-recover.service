[Unit]
Description=Recover interrupted native account backup operations
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/local/lib/timeline-native-ops/native_backup_controller.py recover-interrupted
TimeoutStartSec=180
TimeoutStopSec=30
KillMode=control-group
MemoryMax=512M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/timeline-native-backups

[Install]
WantedBy=multi-user.target
