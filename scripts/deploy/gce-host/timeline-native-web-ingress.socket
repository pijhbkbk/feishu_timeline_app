[Unit]
Description=Native web production loopback socket
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
Requires=sysinit.target timeline-native-cutover-recover.service timeline-native-network.service
After=sysinit.target timeline-native-cutover-recover.service timeline-native-network.service

[Socket]
ExecStartPre=/usr/bin/python3 -I /usr/local/lib/timeline-native-ops/native_cutover.py check-committed
ListenStream=127.0.0.1:3000
NoDelay=true
Backlog=64

[Install]
WantedBy=multi-user.target
