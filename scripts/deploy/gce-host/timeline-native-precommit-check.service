[Unit]
Description=Bounded precommit interruption recovery rehearsal
Requires=postgresql.service timeline-native-cutover-recover.service timeline-native-network.service
After=postgresql.service timeline-native-cutover-recover.service timeline-native-network.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/timeline-native-ops/native_cutover.py precommit-recovery-check
ExecStopPost=/usr/bin/python3 -I /usr/local/lib/timeline-native-ops/native_cutover.py recover
TimeoutStartSec=600
TimeoutStopSec=180
KillMode=control-group
UMask=0077
MemoryMax=512M
TasksMax=64
