[Unit]
Description=Recover interrupted native administrator preparation
Requires=postgresql.service
Wants=docker.service
After=postgresql.service docker.service timeline-native-migration-probe-recover.service
Before=timeline-native-network.service timeline-native-api.service timeline-native-web.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/timeline-native-ops/native_runtime_app.py recover-preparation
RemainAfterExit=yes
TimeoutStartSec=120
UMask=0077

[Install]
WantedBy=multi-user.target
