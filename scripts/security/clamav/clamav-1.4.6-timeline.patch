+/* The accept thread owns listener closure after it starts.  Invalidate the
+ * original array before close so later cleanup cannot act on a reused number.
+ * The caller only reads this array before thread creation or after join. */
+static void close_accept_fd(struct acceptdata *data, struct fd_buf *buf)
+{
+    int fd = buf->fd;
+    unsigned i;
+    if (fd < 0)
+        return;
+    for (i = 0; i < data->listener_count; i++) {
+        if (data->listener_fds[i] == fd)
+            data->listener_fds[i] = -1;
+    }
+    buf->fd = -1;
+    shutdown(fd, 2);
+    closesocket(fd);
+}
 
