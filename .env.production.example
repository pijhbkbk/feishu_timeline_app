# Use this file as a review template when preparing:
# - /etc/feishu-timeline/api.env
# - /etc/feishu-timeline/web.env
# Not every variable belongs in both files.
# Do not commit real secrets, passwords, or tokens.

# Deployment metadata
# Current app code does not read these directly. They help keep root and subdomain roles clear.
ROOT_DOMAIN=all-too-well.com
APP_HOST=timeline.all-too-well.com
PUBLIC_APP_URL=https://timeline.all-too-well.com

# API runtime
NODE_ENV=production
DEPLOYMENT_ENV=production
HOST=127.0.0.1
PORT=3001
FRONTEND_URL=https://timeline.all-too-well.com
# These are deliberately non-runnable placeholders. Replace them through the
# approved secret-management path; protected environments reject placeholders,
# local hosts, missing authentication and passwords shorter than 20 characters.
DATABASE_URL=postgresql://db_user:replace-with-strong-db-password@db-host:5432/db_name?schema=public
REDIS_URL=redis://:replace-with-strong-redis-password@redis-host:6379

# Notifications
NOTIFICATION_QUEUE_ENABLED=true
NOTIFICATION_QUEUE_POLL_MS=5000
NOTIFICATION_OVERDUE_SCAN_MS=300000
NOTIFICATION_RETRY_DELAY_MS=5000
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_REDIS_QUEUE_MAX_JOBS=2000
NOTIFICATION_MEMORY_QUEUE_MAX_JOBS=1000
NOTIFICATION_MEMORY_DEDUPE_MAX_KEYS=5000
NOTIFICATION_JOB_MAX_BYTES=65536
NOTIFICATION_SCAN_BATCH_SIZE=100
NOTIFICATION_SCAN_MAX_ITEMS=1000

# Auth
AUTH_MOCK_ENABLED=false
SESSION_COOKIE_NAME=ft_session
SESSION_TTL_SECONDS=28800

# Object storage
# Current confirmed production attachment directory is /opt/feishu_timeline_app/var/object-storage.
# Keep this value aligned with the real runtime behavior on the target host.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=/opt/feishu_timeline_app/var/object-storage
OBJECT_STORAGE_ENDPOINT=https://object-storage.example
OBJECT_STORAGE_BUCKET=replace-me
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me

# Malware scanning
# Production must use an approved real scanner endpoint. The application rejects
# local/mock providers and placeholder hosts in protected environments.
MALWARE_SCANNER_PROVIDER=clamav
CLAMAV_HOST=replace-with-approved-clamav-host
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# Upload admission (per API process; bounded at or below ClamAV concurrency)
UPLOAD_ADMISSION_GLOBAL_LIMIT=4
UPLOAD_ADMISSION_PER_ACTOR_LIMIT=2
UPLOAD_ADMISSION_PER_TARGET_LIMIT=3
UPLOAD_ADMISSION_RATE_MAX_REQUESTS=6
UPLOAD_ADMISSION_RATE_WINDOW_MS=60000
DOWNLOAD_ADMISSION_GLOBAL_LIMIT=8
DOWNLOAD_ADMISSION_PER_ACTOR_LIMIT=2
DOWNLOAD_ADMISSION_PER_TARGET_LIMIT=2
DOWNLOAD_ADMISSION_RATE_MAX_REQUESTS=12
DOWNLOAD_ADMISSION_RATE_WINDOW_MS=60000

# Attachment storage quotas and reconciliation
ATTACHMENT_STORAGE_GLOBAL_MAX_BYTES=5368709120
ATTACHMENT_STORAGE_PROJECT_MAX_BYTES=1073741824
ATTACHMENT_STORAGE_ACTOR_MAX_BYTES=536870912
ATTACHMENT_STORAGE_GLOBAL_MAX_OBJECTS=5000
ATTACHMENT_STORAGE_PROJECT_MAX_OBJECTS=1000
ATTACHMENT_STORAGE_ACTOR_MAX_OBJECTS=500
ATTACHMENT_STORAGE_MIN_FREE_BYTES=1073741824
ATTACHMENT_STORAGE_RESERVATION_TTL_MS=7200000
ATTACHMENT_STORAGE_ACTOR_WINDOW_MS=2592000000
ATTACHMENT_STORAGE_RECONCILE_INTERVAL_MS=300000
ATTACHMENT_STORAGE_RECONCILE_BATCH_SIZE=100
ATTACHMENT_STORAGE_RECONCILIATION_LEASE_MS=300000
ATTACHMENT_STORAGE_RECONCILIATION_RETRY_MS=300000
ATTACHMENT_STORAGE_PURGED_METADATA_RETENTION_MS=7776000000

# Supplier catalog and mutation admission
SUPPLIER_CATALOG_MAX_ITEMS=5000
SUPPLIER_MUTATION_MAX_REQUESTS=30
SUPPLIER_MUTATION_WINDOW_MS=3600000

# Feishu auth
FEISHU_APP_ID=replace-me
FEISHU_APP_SECRET=replace-me
FEISHU_REDIRECT_URI=https://timeline.all-too-well.com/login/callback
OAUTH_PROVIDER=feishu-cn
# Official Feishu authorization endpoint. Keep this aligned with the same Feishu environment
# used by FEISHU_APP_ID / FEISHU_APP_SECRET.
FEISHU_AUTHORIZATION_ENDPOINT=https://accounts.feishu.cn/open-apis/authen/v1/index
FEISHU_OAUTH_OVERALL_TIMEOUT_MS=10000
FEISHU_OAUTH_MAX_CONCURRENT_REQUESTS=8

# Web public env
NEXT_PUBLIC_APP_NAME=轻卡新颜色开发项目管理系统
# Keep /api when timeline.all-too-well.com forwards same-origin /api/* requests to Nest.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_FEISHU_APP_ID=replace-me-if-needed
NEXT_PUBLIC_ENABLE_MOCK_LOGIN=false
