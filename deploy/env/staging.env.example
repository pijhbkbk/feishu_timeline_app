COMPOSE_PROJECT_NAME=feishu-timeline-staging
DEPLOYMENT_ENV=staging
API_IMAGE_REPO=feishu-timeline-api
API_OPS_IMAGE_REPO=feishu-timeline-api-ops
WEB_IMAGE_REPO=feishu-timeline-web

STAGING_HTTP_PORT=8080
STAGING_WEB_PORT=3100
STAGING_API_PORT=3101
STAGING_POSTGRES_PORT=15432
STAGING_REDIS_PORT=16379

POSTGRES_DB=feishu_timeline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password

FRONTEND_URL=http://localhost:8080
DATABASE_URL=postgresql://postgres:replace-with-strong-postgres-password@postgres:5432/feishu_timeline?schema=public
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379

AUTH_MOCK_ENABLED=false
SESSION_COOKIE_NAME=ft_session
SESSION_TTL_SECONDS=28800

NOTIFICATION_QUEUE_ENABLED=true
NOTIFICATION_QUEUE_POLL_MS=5000
NOTIFICATION_OVERDUE_SCAN_MS=300000
NOTIFICATION_RETRY_DELAY_MS=5000
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_REDIS_QUEUE_MAX_JOBS=2000
NOTIFICATION_MEMORY_QUEUE_MAX_JOBS=1000
NOTIFICATION_MEMORY_DEDUPE_MAX_KEYS=5000
NOTIFICATION_JOB_MAX_BYTES=65536
NOTIFICATION_SCAN_BATCH_SIZE=100
NOTIFICATION_SCAN_MAX_ITEMS=1000
SUPPLIER_CATALOG_MAX_ITEMS=5000
SUPPLIER_MUTATION_MAX_REQUESTS=30
SUPPLIER_MUTATION_WINDOW_MS=3600000

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=/app/var/object-storage
OBJECT_STORAGE_ENDPOINT=http://minio.local
OBJECT_STORAGE_BUCKET=feishu-timeline-staging
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
ATTACHMENT_STORAGE_GLOBAL_MAX_BYTES=5368709120
ATTACHMENT_STORAGE_PROJECT_MAX_BYTES=1073741824
ATTACHMENT_STORAGE_ACTOR_MAX_BYTES=536870912
ATTACHMENT_STORAGE_GLOBAL_MAX_OBJECTS=5000
ATTACHMENT_STORAGE_PROJECT_MAX_OBJECTS=1000
ATTACHMENT_STORAGE_ACTOR_MAX_OBJECTS=500
ATTACHMENT_STORAGE_MIN_FREE_BYTES=1073741824
ATTACHMENT_STORAGE_RESERVATION_TTL_MS=7200000
ATTACHMENT_STORAGE_ACTOR_WINDOW_MS=2592000000
ATTACHMENT_STORAGE_RECONCILE_INTERVAL_MS=300000
ATTACHMENT_STORAGE_RECONCILE_BATCH_SIZE=100
ATTACHMENT_STORAGE_RECONCILIATION_LEASE_MS=300000
ATTACHMENT_STORAGE_RECONCILIATION_RETRY_MS=300000
ATTACHMENT_STORAGE_PURGED_METADATA_RETENTION_MS=7776000000

MALWARE_SCANNER_PROVIDER=clamav
CLAMAV_HOST=replace-with-approved-clamav-host
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

UPLOAD_ADMISSION_GLOBAL_LIMIT=4
UPLOAD_ADMISSION_PER_ACTOR_LIMIT=2
UPLOAD_ADMISSION_PER_TARGET_LIMIT=3
UPLOAD_ADMISSION_RATE_MAX_REQUESTS=6
UPLOAD_ADMISSION_RATE_WINDOW_MS=60000
DOWNLOAD_ADMISSION_GLOBAL_LIMIT=8
DOWNLOAD_ADMISSION_PER_ACTOR_LIMIT=2
DOWNLOAD_ADMISSION_PER_TARGET_LIMIT=2
DOWNLOAD_ADMISSION_RATE_MAX_REQUESTS=12
DOWNLOAD_ADMISSION_RATE_WINDOW_MS=60000
API_MEM_LIMIT=768m
API_PIDS_LIMIT=256

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:8080/login/callback
OAUTH_PROVIDER=feishu-cn
FEISHU_AUTHORIZATION_ENDPOINT=https://accounts.feishu.cn/open-apis/authen/v1/index

NEXT_PUBLIC_APP_NAME=轻卡新颜色开发项目管理系统
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_ENABLE_MOCK_LOGIN=false
NEXT_PUBLIC_UI_VERSION=v2
NEXT_PUBLIC_UI_DATA_MODE=real
V1_FALLBACK_ENABLED=false
NEXT_PUBLIC_R26_V2_PROTOTYPE=false
NEXT_PUBLIC_R26_V2_DATA_MODE=read-only-real
RUNTIME_COMMIT=replace-with-full-40-hex-release-commit
BUILD_TIME=replace-with-utc-rfc3339-build-time
RELEASE=replace-with-immutable-release-id
