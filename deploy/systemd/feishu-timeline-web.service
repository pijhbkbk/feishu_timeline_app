[Unit]
Description=Feishu Timeline Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__WEB_RUNTIME_USER__
Group=__WEB_RUNTIME_GROUP__
WorkingDirectory=/opt/feishu_timeline_app/current/apps/web
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/python3 -I /usr/local/libexec/feishu-timeline/dotenv-data validate --profile web /etc/feishu-timeline/web.env
ExecStartPre=/usr/bin/test -d /opt/feishu_timeline_app/current/apps/web/.next
ExecStartPre=/usr/bin/node --version
ExecStart=/usr/bin/python3 -I /usr/local/libexec/feishu-timeline/dotenv-data exec --profile web /etc/feishu-timeline/web.env -- /usr/bin/node /opt/feishu_timeline_app/current/apps/web/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
SyslogIdentifier=feishu-timeline-web
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ReadOnlyPaths=/opt/feishu_timeline_app/releases
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
UMask=0027
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
